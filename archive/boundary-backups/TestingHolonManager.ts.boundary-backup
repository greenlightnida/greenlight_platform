  private async loadFeaturesRegistry(): Promise<any> {
    try {
      const registryPath = path.join(process.cwd(), 'data', 'featuresRegistry.json');
      const registryData = fs.readFileSync(registryPath, 'utf8');
      return JSON.parse(registryData);
