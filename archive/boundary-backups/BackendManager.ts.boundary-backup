  private async initializeBackendManager(): Promise<void> {
    try {
      // Ensure config directory exists
      if (!fs.existsSync(this.configPath)) {
        fs.mkdirSync(this.configPath, { recursive: true });
      }

      // Save initial configuration
      await this.saveConfiguration();

      // Start monitoring
      await this.startMonitoring();

      console.log('✅ BackendManager initialized successfully');
      this.emit('initialized');
    } catch (error) {
      console.error('❌ Failed to initialize BackendManager:', error);
      throw error;
    }
  }

  private async saveConfiguration(): Promise<void> {
    try {
      const configFile = path.join(this.configPath, 'backend-config.json');
      await fs.promises.writeFile(
        configFile,
        JSON.stringify(this.state, null, 2)
      );
    } catch (error) {
      console.error('Failed to save backend configuration:', error);
    }
  }

  private async startMonitoring(): Promise<void> {
    // Start backend monitoring
    setInterval(() => {
      this.updateBackendMonitoring();
    }, 30000); // Every 30 seconds
  }

  private updateBackendMonitoring(): void {
    // Update backend monitoring metrics
    this.emit('monitoring-updated', {
      timestamp: new Date(),
      health: this.state.backendOperations.health,
      performance: this.state.backendOperations.performance,
      reliability: this.state.backendOperations.reliability
    });
  }

