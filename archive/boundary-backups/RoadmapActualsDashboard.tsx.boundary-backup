            </div>
          )}
          
          {riskAnalysis.mitigationStrategies.length > 0 && (
            <div className="mb-4">
              <h4 className="text-md font-semibold mb-3">Mitigation Strategies</h4>
              <ul className="space-y-2">
                {riskAnalysis.mitigationStrategies.map((strategy, index) => (
                  <li key={index} className="flex items-start">
                    <span className="text-blue-600 mr-2">•</span>
                    <span>{strategy}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
          
          <h4 className="text-md font-semibold mb-3">Risk Recommendations</h4>
          <ul className="space-y-2">
            {riskAnalysis.recommendations.map((recommendation, index) => (
              <li key={index} className="flex items-start">
                <span className="text-blue-600 mr-2">•</span>
                <span>{recommendation}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    );
  };

  const renderForecastView = () => {
    if (!currentReport) return null;
    
    const { forecast } = currentReport;
    
    return (
      <div className="space-y-6">
        <div className="bg-white rounded-lg shadow p-6">
          <h3 className="text-lg font-semibold mb-4">Project Forecast</h3>
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
            <div className="text-center">
              <div className="text-2xl font-bold text-blue-600">
                {forecast.projectedCompletionDate.toLocaleDateString()}
              </div>
              <div className="text-sm text-gray-600">Projected Completion</div>
            </div>
            <div className="text-center">
              <div className="text-2xl font-bold text-purple-600">
                {forecast.projectedEffort.toFixed(0)} hours
              </div>
              <div className="text-sm text-gray-600">Projected Effort</div>
            </div>
            <div className="text-center">
              <div className={`text-2xl font-bold ${
                forecast.confidenceLevel === 'high' ? 'text-green-600' :
                forecast.confidenceLevel === 'medium' ? 'text-yellow-600' :
                'text-red-600'
              }`}>
                {forecast.confidenceLevel.toUpperCase()}
              </div>
              <div className="text-sm text-gray-600">Confidence Level</div>
            </div>
          </div>
          
          <div className="bg-blue-50 p-4 rounded-lg">
            <h4 className="text-md font-semibold mb-2">Forecast Notes</h4>
            <p className="text-sm text-gray-700">
              This forecast is based on historical performance data and current project progress. 
              The confidence level indicates the reliability of these projections based on the 
              amount and consistency of historical data available.
            </p>
          </div>
        </div>
      </div>
    );
  };

  const renderView = () => {
    switch (selectedView) {
      case 'summary':
        return renderSummaryView();
      case 'timeline':
        return renderTimelineView();
      case 'effort':
        return renderEffortView();
      case 'quality':
        return renderQualityView();
      case 'risk':
        return renderRiskView();
      case 'forecast':
        return renderForecastView();
      default:
        return renderSummaryView();
    }
  };

  return (
    <div className={`roadmap-actuals-dashboard ${className}`}>
      <div className="bg-white rounded-lg shadow p-6 mb-6">
        <div className="flex flex-col md:flex-row md:items-center md:justify-between mb-6">
          <div>
            <h1 className="text-2xl font-bold text-gray-900">Roadmap Actuals Dashboard</h1>
            <p className="text-gray-600">Planned vs. Actual Development Progress Tracking</p>
          </div>
          <div className="flex space-x-4 mt-4 md:mt-0">
            <select
              value={selectedPeriod}
              onChange={(e) => setSelectedPeriod(e.target.value as 'weekly' | 'monthly' | 'quarterly')}
              className="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <option value="weekly">Weekly</option>
              <option value="monthly">Monthly</option>
              <option value="quarterly">Quarterly</option>
            </select>
            <button
              onClick={generateReport}
              disabled={isLoading}
              className="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:opacity-50"
            >
              {isLoading ? 'Generating...' : 'Generate Report'}
            </button>
          </div>
        </div>

        {/* Navigation Tabs */}
        <div className="border-b border-gray-200">
          <nav className="-mb-px flex space-x-8">
            {[
              { id: 'summary', label: 'Summary' },
              { id: 'timeline', label: 'Timeline' },
              { id: 'effort', label: 'Effort' },
              { id: 'quality', label: 'Quality' },
              { id: 'risk', label: 'Risk' },
              { id: 'forecast', label: 'Forecast' }
            ].map((tab) => (
              <button
                key={tab.id}
                onClick={() => setSelectedView(tab.id as any)}
                className={`py-2 px-1 border-b-2 font-medium text-sm ${
                  selectedView === tab.id
                    ? 'border-blue-500 text-blue-600'
                    : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'
                }`}
              >
                {tab.label}
              </button>
            ))}
          </nav>
        </div>
      </div>

      {/* Content Area */}
      <div className="min-h-screen">
        {isLoading ? (
          <div className="flex items-center justify-center h-64">
            <div className="text-center">
              <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto mb-4"></div>
              <p className="text-gray-600">Loading actuals data...</p>
            </div>
          </div>
        ) : currentReport ? (
          renderView()
        ) : (
          <div className="text-center py-12">
            <p className="text-gray-600">No actuals data available. Generate a report to view metrics.</p>
          </div>
        )}
      </div>
    </div>
  );
}; 