    return this.state.frontendIntegration.realTimeUpdates;
  }

  public getExternalServiceIntegration(): ExternalServiceIntegration {
    return this.state.frontendIntegration.externalServices;
  }

  // Health check
  public async healthCheck(): Promise<{
    status: 'healthy' | 'degraded' | 'unhealthy';
    timestamp: Date;
    metrics: Record<string, any>;
  }> {
    try {
      const metrics = {
        designSystem: this.state.frontendGovernance.designSystem,
        componentLibrary: this.state.frontendGovernance.componentLibrary,
        stateManagement: this.state.frontendGovernance.stateManagement,
        routing: this.state.frontendGovernance.routing,
        performance: this.state.frontendOperations.performance,
        accessibility: this.state.frontendOperations.accessibility,
        security: this.state.frontendOperations.security
      };

      return {
        status: 'healthy',
        timestamp: new Date(),
        metrics
      };
    } catch (error) {
      return {
        status: 'unhealthy',
        timestamp: new Date(),
        metrics: { error: error.message }
      };
    }
  }
}

export default FrontendManager; 