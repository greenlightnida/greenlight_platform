  private async initializeFrontendManager(): Promise<void> {
    try {
      // Ensure config directory exists
      if (!fs.existsSync(this.configPath)) {
        fs.mkdirSync(this.configPath, { recursive: true });
      }

      // Save initial configuration
      await this.saveConfiguration();

      // Start monitoring
      await this.startMonitoring();

      console.log('✅ FrontendManager initialized successfully');
      this.emit('initialized');
    } catch (error) {
      console.error('❌ Failed to initialize FrontendManager:', error);
      throw error;
    }
  }

  private async saveConfiguration(): Promise<void> {
    try {
      const configFile = path.join(this.configPath, 'frontend-config.json');
      await fs.promises.writeFile(
        configFile,
        JSON.stringify(this.state, null, 2)
      );
    } catch (error) {
      console.error('Failed to save frontend configuration:', error);
    }
  }

  private async startMonitoring(): Promise<void> {
    // Start frontend monitoring
    setInterval(() => {
      this.updateFrontendMonitoring();
    }, 30000); // Every 30 seconds
  }

  private updateFrontendMonitoring(): void {
    // Update frontend monitoring metrics
    this.emit('monitoring-updated', {
      timestamp: new Date(),
      performance: this.state.frontendOperations.performance,
      accessibility: this.state.frontendOperations.accessibility,
      security: this.state.frontendOperations.security
    });
  }

