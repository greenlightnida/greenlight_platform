const usePlayerState = () => \{\
  const [playerState, setPlayerState] = useReducer(playerReducer, \{\
    currentTrack: null,\
    isPlaying: false,\
    currentTime: 0,\
    volume: 0.7,\
    queue: []\
  \});\
\
  const actions = useMemo(() => (\{\
    play: () => setPlayerState(\{ type: 'PLAY' \}),\
    pause: () => setPlayerState(\{ type: 'PAUSE' \}),\
    seek: (time) => setPlayerState(\{ type: 'SEEK', payload: time \}),\
    setVolume: (volume) => setPlayerState(\{ type: 'SET_VOLUME', payload: volume \})\
  \}), []);\
\
  return [playerState, actions];\
\};\
