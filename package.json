{
  "name": "greenlight-platform",
  "version": "1.0.0",
  "description": "Greenlight Platform - Central governance and monitoring system",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "anchor": "node scripts/command_coordinator.cjs anchor",
    "anchor:quick": "node scripts/command_coordinator.cjs anchor --quick",
    "anchor:core": "node scripts/command_coordinator.cjs anchor --core",
    "checkpoint": "node scripts/command_coordinator.cjs checkpoint",
    "checkpoint:deep": "node scripts/command_coordinator.cjs checkpoint --deep",
    "launch": "node scripts/command_coordinator.cjs launch",
    "launch-annihilate": "node scripts/command_coordinator.cjs launch-annihilate",
    "prewrap": "node scripts/command_coordinator.cjs prewrap",
    "wrap": "node scripts/command_coordinator.cjs wrap",
    "wrap-annihilate": "node scripts/command_coordinator.cjs wrap-annihilate",
    "command-center": "node scripts/protocols/command_center_manager.cjs",
    "session-optimization": "node scripts/protocols/session_optimization_collaboration.cjs",
    "pm-session-test": "node scripts/protocols/performance_manager_session_test.cjs",
    "command-cycle-test": "node scripts/protocols/automated_command_cycle_test.cjs",
    "system-assessment": "node scripts/protocols/system_wide_assessment.cjs",
    "comprehensive-governance-test": "node scripts/protocols/comprehensive_governance_test.cjs",
    "comprehensive-strategy": "node scripts/comprehensive_strategy.cjs",
    "comprehensive-reconcile": "node scripts/comprehensive_strategy.cjs execute",
    "comprehensive-monitor": "node scripts/comprehensive_strategy.cjs monitor",
    "comprehensive-status": "node scripts/comprehensive_strategy.cjs status",
    "background-status": "node scripts/protocols/background_process_status.cjs",
    "convene-council": "node scripts/protocols/council_command.cjs \"convene the council\"",
    "consult-council": "node scripts/protocols/council_command.cjs \"consult the council\"",
    "query-council": "node scripts/protocols/council_command.cjs \"query the council\"",
    "prepare-docket": "node scripts/protocols/council_command.cjs \"prepare the docket\"",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "commit": "cz",
    "prepare": "husky install"
  },
  "keywords": [
    "platform",
    "api-management",
    "graph-database",
    "ai-optimization",
    "monitoring"
  ],
  "author": "Greenlight Platform Team",
  "license": "MIT",
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@supabase/supabase-js": "^2.50.3",
    "@types/axios": "^0.9.36",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/uuid": "^10.0.0",
    "axios": "^1.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "google-auth-library": "^10.1.0",
    "googleapis": "^128.0.0",
    "helmet": "^7.1.0",
    "lucide-react": "^0.525.0",
    "minimist": "^1.2.8",
    "neo4j-driver": "^5.15.0",
    "openai": "^5.8.2",
    "recharts": "^3.0.2",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/addon-viewport": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/testing-library": "^0.2.1",
    "@testing-library/react": "^16.3.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.19.5",
    "@types/testing-library__react": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.55.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^51.3.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.3.0",
    "unimport": "^5.1.0",
    "vitest": "^3.2.4",
    "zod": "^3.25.76"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
