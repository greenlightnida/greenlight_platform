              "name": "update_updated_at_column",
              "version": "1.0.0",
              "language": "plpgsql",
              "body": "\n            CREATE OR REPLACE FUNCTION update_updated_at_column()\n            RETURNS TRIGGER AS $$\n            BEGIN\n              NEW.updated_at = NOW();\n              RETURN NEW;\n            END;\n            $$ language 'plpgsql';\n          "
            }
