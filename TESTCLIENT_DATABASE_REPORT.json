          "views": [
            {
              "name": "user_sessions_view",
              "version": "1.0.0",
              "query": "\n            SELECT \n              u.id as user_id,\n              u.email,\n              u.name,\n              s.id as session_id,\n              s.created_at as session_created,\n              s.expires_at as session_expires\n            FROM users u\n            LEFT JOIN sessions s ON u.id = s.user_id\n            WHERE s.expires_at > NOW()\n          "
            }
          ],
