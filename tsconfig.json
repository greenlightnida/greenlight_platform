{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "noImplicitThis": false,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src/**/*",
    "frontend/src/**/*",
    "backend/src/**/*"
  ],
  "exclude": [
    "src/core/holons/testing/TestingHolonManager.ts",
    "src/core/holons/operations/ErrorManagerHolon.ts",
    "src/core/holons/product/modules/CoordinationEngine.ts",
    "src/core/holons/product/ProductHolon.ts",
    "src/core/holons/security/SecurityManagementTeam.ts",
    "src/core/holons/systemMaster/modules/Governance.ts",
    "src/core/operations/ServerManager.ts",
    "src/core/operations/ServerGovernor.ts",
    "src/core/session-management/SessionsManager.tsx",
    "src/dashboards/executive/ExecutiveDashboard.tsx",
    "src/dashboards/governance/PerformanceManagerDashboard.tsx",
    "src/dashboards/roadmap/RoadmapDashboard.tsx",
    "src/types/schemas.ts",
    "src/utils/cache/cache.ts",
    "src/utils/common/formatting.ts",
    "src/utils/common/validation.ts",
    "node_modules",
    "dist",
    "dist-backend"
  ],

} 