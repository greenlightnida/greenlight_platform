{
  "version": "1.0.0",
  "name": "Greenlight Platform Deployment Pipeline",
  "description": "Self-service deployment pipeline inspired by Port.io's internal deployment system",
  "defaultEnvironment": "staging",
  "deploymentTypes": [
    "manual",
    "automated", 
    "blue-green",
    "canary"
  ],
  "healthCheckTimeout": 30000,
  "rollbackEnabled": true,
  "featureFlagsEnabled": true,
  "monitoring": {
    "enabled": true,
    "metrics": [
      "responseTime",
      "errorRate", 
      "uptime",
      "throughput"
    ],
    "alerts": [
      "highErrorRate",
      "slowResponse",
      "downtime",
      "resourceExhaustion"
    ]
  },
  "environments": {
    "development": {
      "type": "local",
      "url": "http://localhost:3000",
      "healthCheckUrl": "http://localhost:3000/health",
      "deployCommands": ["npm run dev"],
      "requirements": [
        {
          "type": "command",
          "name": "Node.js",
          "command": "node --version"
        },
        {
          "type": "command", 
          "name": "npm",
          "command": "npm --version"
        }
      ]
    },
    "staging": {
      "type": "staging",
      "url": "https://staging.greenlight.live",
      "healthCheckUrl": "https://staging.greenlight.live/health",
      "deployCommands": ["npm run build", "npm run deploy:staging"],
      "requirements": [
        {
          "type": "command",
          "name": "Vercel CLI",
          "command": "vercel --version"
        }
      ]
    },
    "production": {
      "type": "production", 
      "url": "https://greenlight.live",
      "healthCheckUrl": "https://greenlight.live/health",
      "deployCommands": ["npm run build", "npm run deploy:production"],
      "requirements": [
        {
          "type": "command",
          "name": "Vercel CLI",
          "command": "vercel --version"
        },
        {
          "type": "file",
          "name": "Production Config",
          "path": "config/environments/production.env"
        }
      ]
    }
  },
  "blueprints": {
    "greenlight-platform": {
      "name": "Greenlight Platform",
      "version": "1.0.0",
      "type": "platform",
      "sourcePath": ".",
      "build": ["npm run build"],
      "deploy": ["npm run deploy"],
      "dependencies": [],
      "healthCheck": {
        "url": "/health",
        "timeout": 30000
      }
    },
    "frontend": {
      "name": "Frontend Application",
      "version": "1.0.0", 
      "type": "frontend",
      "sourcePath": "frontend",
      "build": ["npm run build"],
      "deploy": ["npm run deploy"],
      "dependencies": [],
      "healthCheck": {
        "url": "/",
        "timeout": 30000
      }
    },
    "backend": {
      "name": "Backend API",
      "version": "1.0.0",
      "type": "backend", 
      "sourcePath": "backend",
      "build": ["npm run build"],
      "deploy": ["npm run deploy"],
      "dependencies": [],
      "healthCheck": {
        "url": "/api/health",
        "timeout": 30000
      }
    }
  },
  "integrations": {
    "vercel": {
      "enabled": true,
      "config": {
        "buildCommand": "npm run build",
        "outputDirectory": "dist",
        "framework": "vite"
      }
    },
    "netlify": {
      "enabled": false,
      "config": {
        "buildCommand": "npm run build",
        "publish": "dist"
      }
    },
    "supabase": {
      "enabled": true,
      "config": {
        "migrations": true,
        "functions": true
      }
    }
  },
  "security": {
    "secretsManagement": true,
    "environmentVariables": true,
    "accessControl": true,
    "auditLogging": true
  },
  "notifications": {
    "slack": {
      "enabled": false,
      "webhook": ""
    },
    "email": {
      "enabled": false,
      "recipients": []
    }
  }
} 