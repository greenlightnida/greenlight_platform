# Google Workspace SSO Environment Variables
# Copy this file to .env and fill in the values

# Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://greenlight.live/auth/google/callback
GOOGLE_HOSTED_DOMAIN=greenlight.live

# Google Admin SDK Configuration
GOOGLE_ADMIN_EMAIL=admin@greenlight.live
GOOGLE_ADMIN_KEY_PATH=/path/to/service-account-key.json

# Security Configuration
SESSION_SECRET=your_session_secret_here
JWT_SECRET=your_jwt_secret_here
MFA_ENABLED=true
SESSION_TIMEOUT=28800000  # 8 hours

# Platform URLs
WIKI_HOLON_URL=https://wiki.greenlight.live
SYSTEM_GOVERNANCE_URL=https://greenlight.live
PRODUCT_PLATFORMS_URL=https://topbins.com

# User Groups
ADMIN_GROUP=greenlight-admins@greenlight.live
DEVELOPER_GROUP=greenlight-developers@greenlight.live
USER_GROUP=greenlight-users@greenlight.live

# Security Policies
PASSWORD_MIN_LENGTH=12
PASSWORD_ROTATION_DAYS=90
SESSION_TIMEOUT_HOURS=8
MFA_BACKUP_CODES=10