# Greenlight Platform - Production Environment Configuration
# Google Workspace SSO Configuration
# IMPORTANT: Replace placeholder values with actual production credentials

# OAuth 2.0 Credentials
GOOGLE_OAUTH_CLIENT_ID=your-production-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-production-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://greenlight.live/auth/google/callback
GOOGLE_OAUTH_HOSTED_DOMAIN=greenlight.live

# Google Admin SDK Configuration
GOOGLE_ADMIN_EMAIL=your-production-admin-email
GOOGLE_ADMIN_KEY_PATH=./production-service-account-key.json
GOOGLE_ADMIN_SERVICE_ACCOUNT_ID=your-production-service-account-id

# Platform URLs
WIKI_HOLON_URL=https://wiki.greenlight.live
SYSTEM_GOVERNANCE_URL=https://greenlight.live
PRODUCT_PLATFORMS_URL=https://www.topbinsid.com

# User Groups
GOOGLE_GROUP_ADMINS=greenlight-admins@greenlight.live
GOOGLE_GROUP_DEVELOPERS=greenlight-developers@greenlight.live
GOOGLE_GROUP_USERS=greenlight-users@greenlight.live

# Security Configuration
SESSION_TIMEOUT=28800000
JWT_SECRET=your-production-jwt-secret-key
ENCRYPTION_KEY=your-production-encryption-key

# Server Configuration
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=your-production-database-url
REDIS_URL=your-production-redis-url

# Monitoring and Analytics
SENTRY_DSN=your-production-sentry-dsn
ANALYTICS_ID=your-production-analytics-id

# SSL Configuration
SSL_CERT_PATH=/path/to/ssl/certificate
SSL_KEY_PATH=/path/to/ssl/private/key
SSL_CA_PATH=/path/to/ssl/ca/bundle 